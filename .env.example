# Veynqor website environment variables.
# Copy to .env.local for local dev, and add the same keys in Vercel project settings.
#
# ----------------------------------------------------------------------------
# EMAIL / NEWSLETTER (powers the Kickstarter "notify me" form -> /api/notify)
# ----------------------------------------------------------------------------
# Pick ONE provider. Default is convertkit. Set the matching keys below.
NEWSLETTER_PROVIDER=convertkit   # convertkit | mailchimp | mailerlite

# --- ConvertKit (Kit) ---
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Mailchimp (only if NEWSLETTER_PROVIDER=mailchimp) ---
# API key ends with a datacenter suffix, e.g. abc123-us21
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# --- MailerLite (only if NEWSLETTER_PROVIDER=mailerlite) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=          # optional

# ----------------------------------------------------------------------------
# OPTIONAL: mirror every signup into an Airtable table as a backup/CRM view.
# Leave blank to disable. Table needs columns: Email, Source, Signed Up.
# ----------------------------------------------------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Subscribers

# ----------------------------------------------------------------------------
# OPTIONAL: Slack ping on new signups (reuses your existing contact webhook).
# Also used by the existing /api/contact route.
# ----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
